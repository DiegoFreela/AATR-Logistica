# ============================================================
# AATR Transporte & Logística
# Regras do servidor Apache (hospedagem compartilhada)
# ============================================================

# ---------- Página inicial ----------
DirectoryIndex index.html index.php

# ---------- HTTPS obrigatório ----------
# O GPS da área do motorista SÓ funciona em https.
# Descomente as três linhas abaixo depois que o certificado
# estiver ativo no domínio.
#
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---------- Arquivos que não devem ser baixados ----------
<FilesMatch "^(config\.php|config\.local\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|log|md|bak|rar|zip|bat|ps1|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------- Não listar o conteúdo das pastas ----------
Options -Indexes

# ---------- Cabeçalhos de segurança ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------- Cache dos arquivos estáticos ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png        "access plus 30 days"
    ExpiresByType image/jpeg       "access plus 30 days"
    ExpiresByType image/svg+xml    "access plus 30 days"
    ExpiresByType text/css         "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# ---------- Compressão ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json
</IfModule>
